# === Required ===
# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The numeric chat ID of the PRIVATE ADMIN GROUP where deposit approvals will be sent.
# How to get it: add your bot to a private group with your admin(s), send any message,
# then visit https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates and look for "chat":{"id": ...}
ADMIN_CHAT_ID=-1001234567890

# The public channel/group username or ID where winners get announced (optional but recommended)
# Example: @MyLotteryChannel  or  -1009876543210
ANNOUNCE_CHAT_ID=@YourAnnouncementChannel

# Your Telebirr number that users should send money to
TELEBIRR_NUMBER=0912345678
TELEBIRR_NAME=Your Company Name

# Minutes a number stays locked/reserved for a user before it auto-releases if unpaid
LOCK_MINUTES=5
